<td id=mwCsY>Removal of unfavorable information</td>
<td id=mwCsc><sup about=#mwt874 class="mw-ref reference" id=cite_ref-ars_261-1 rel=dc:references typeof=mw:Extension/ref data-mw='{"name":"ref","attrs":{"name":"ars"}}'><a href=#cite_note-ars-261 id=mwCsg><span class=mw-reflink-text id=mwCsk><span class=cite-bracket id=mwCso>[</span>261<span class=cite-bracket id=mwCss>]</span></span></a></sup><sup about=#mwt877 class="mw-ref reference" id=cite_ref-wp2006_262-0 rel=dc:references typeof=mw:Extension/ref data-mw='{"name":"ref","attrs":{"name":"wp2006"},"body":{"id":"mw-reference-text-cite_note-wp2006-262"}}'><a href=#cite_note-wp2006-262 id=mwCsw><span class=mw-reflink-text id=mwCs0><span class=cite-bracket id=mwCs4>[</span>262<span class=cite-bracket id=mwCs8>]</span></span></a></sup></tr>
