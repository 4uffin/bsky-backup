 data-mw='{"name":"ref","attrs":{"group":"lower-alpha"},"body":{"id":"mw-reference-text-cite_note-72"},"parts":[{"template":{"target":{"wt":"efn","href":"./Template:Efn"},"params":{"1":{"wt":"As of April 2026, the [[Haitian Creole]] Wikipedia, with 72K articles, is in 91st place when ranked by number of articles."}},"i":0}}]}'><a href=#cite_note-72 data-mw-group=lower-alpha id=mwAdg><span class=mw-reflink-text id=mwAdk><span class=cite-bracket id=mwAdo>[</span>g<span class=cite-bracket id=mwAds>]</span></span></a></sup><br id=mwAdw> The languages are roughly grouped by region:
<br id=mwAd0><span class="mw-empty-elt sf-hidden" about=#mwt232 typeof=mw:Transclusion id=mwAd4 data-mw='{"parts":[{"template":{"target":{"wt":"hlist","href":"./Template:Hlist"},"params":{"1":{"wt":"{{legend0|#002060|[[Northern Europe]]}}"},"2":{"wt":"{{legend0|#C00000[[Southern Europe]]}}"},"3":{"wt":"{{legend0|#BF9000|[[Eastern Europe]]}}"},"4":{"wt":"{{legend0|#C55A11|[[Middle East]]}}"},"5":{"wt":"{{legend0|#548235|[[East Asia]]}}"},"6":{"wt":"{{legend0|#00B0F0|[[Indian subcontinent]]}}"},"7":{"wt":"{{legend0|#925228|[[Sub-Saharan Africa]]}}"},"8":{"wt":"{{legend0|#767171|[[Central Asia]]}}"},"9":{"wt":"{{legend0|#7030A0|[[Caribbean]]}}"}},"i":0}}]}'><link rel=mw-deduplicated-inline-style href=mw-data:TemplateStyles:r1374427404 about=#mwt233 typeof=mw:Extension/templatestyles data-mw='{"name":"templatestyles","attrs":{"src":"Hlist/styles.css"},"body":{"extsrc":""}}'></span><div class=hlist about=#mwt232 id=mwAd8><ul><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#002060;color:#002060><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/Northern_Europe title="Northern Europe">Northern Europe</a></span><li><span style=margin:0px;font-size:90%><span style="border:none;background-color:#C00000[[Southern Europe]];color:#C00000[[Southern Europe]]"><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span></span><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#BF9000;color:#BF9000><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/Eastern_Europe title="Eastern Europe">Eastern Europe</a></span><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#C55A11;color:#C55A11><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/Middle_East title="Middle East">Middle East</a></span><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#548235;color:#548235><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/East_Asia title="East Asia">East Asia</a></span><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#00B0F0;color:#00B0F0><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/Indian_subcontinent title="Indian subcontinent">Indian subcontinent</a></span><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#925228;color:#925228><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/Sub-Saharan_Africa title="Sub-Saharan Africa">Sub-Saharan Africa</a></span><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#767171;color:#767171><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/Central_Asia title="Central Asia">Central Asia</a></span><li><span style=margin:0px;font-size:90%><span style=border:none;background-color:#7030A0;color:#7030A0><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span><span typeof=mw:Entity>&nbsp;</span></span><span typeof=mw:Entity>&nbsp;</span><a rel=mw:WikiLink href=https://en.wikipedia.org/wiki/Caribbean title=Caribbean>Caribbean</a></span></ul></div>
